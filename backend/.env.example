# Copy this file to backend/.env and fill in your key.

# LLM provider: "groq" (free API key from https://console.groq.com/keys) or "ollama" (local, no key)
LLM_PROVIDER=groq
GROQ_API_KEY=

# Optional overrides
# LLM_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=http://localhost:11434/v1   # for Ollama
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDINGS_ENABLED=true
